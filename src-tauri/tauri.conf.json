{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cloudloom",
  "version": "0.8.2",
  "identifier": "studio.red.cloudloom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cloudloom Kestrel",
        "width": 1440,
        "height": 900,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src asset: http://asset.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "resources": ["resources/rclone.exe", "resources/RCLONE-LICENSE.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OTU2OTNFMDExMjVCOUQKUldTZFd4SUJQbW1WUmFoYkZHL01YVjJwa1hZSzRQRmRJbVpMNkZHazhqNTlYNzNQWHFQdnk2cWQK",
      "endpoints": ["https://github.com/prostoodin1/cloudloom-desktop/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "passive" }
    }
  }
}
